# =============================================================================
# MedExplain AI — environment variable template
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# App
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://medexplain:medexplain@localhost:5432/medexplain

# Provider switches (swap without changing business logic)
# LLM_PROVIDER: dashscope | openai | gemini | offline
# Use dashscope (Qwen) when DASHSCOPE_API_KEY is set.
# Use offline for local fixture parsing without cloud credentials.
LLM_PROVIDER=offline
# OCR_PROVIDER: alibaba | tesseract  (tesseract recommended for local/dev)
OCR_PROVIDER=tesseract
# STORAGE_PROVIDER: oss | local
STORAGE_PROVIDER=local

# DashScope / Qwen (primary LLM)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo

# OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini fallback
GEMINI_API_KEY=

# Alibaba Cloud OCR
ALIBABA_OCR_ACCESS_KEY_ID=
ALIBABA_OCR_ACCESS_KEY_SECRET=
ALIBABA_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# Tesseract (local). Leave empty to auto-detect common install paths.
TESSERACT_CMD=

# Alibaba OSS (primary object storage)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_REGION=

# S3-compatible storage (optional)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# Local filesystem storage (dev)
LOCAL_STORAGE_PATH=./uploads
API_PUBLIC_URL=http://localhost:8000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
